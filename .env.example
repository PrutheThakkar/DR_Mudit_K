# Use the production URL from the n8n Webhook node (not the test URL).
GATSBY_N8N_CONTACT_WEBHOOK_URL=https://your-n8n-domain.example/webhook/contact

# Google Analytics 4 measurement ID (Admin > Data streams > Web).
GATSBY_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public WPGraphQL endpoint used at Gatsby build time.
WPGRAPHQL_URL=https://drmuditk.studiosentientdemo.com/graphql
WORDPRESS_USERNAME=your-wordpress-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
